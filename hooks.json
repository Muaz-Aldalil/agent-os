{
  "command-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Skills/.agents/scripts/safety_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
