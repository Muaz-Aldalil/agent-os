      </div>

      <h3 id="story-modal-title" class="font-display font-bold text-xl text-white mt-2 mb-2">Story Title</h3>
      <p id="story-modal-body" class="text-sm text-zinc-200 leading-relaxed mb-4"></p>
      <pre id="story-modal-code" class="hidden rounded-lg bg-w3-slate border-s-4 border-w3-green p-3 font-mono text-xs text-w3-mint overflow-x-auto mb-4"></pre>

      <div class="flex items-center justify-between gap-3 pt-3 border-t border-zinc-700">
        <button type="button" id="story-prev-slide-btn" class="px-4 py-2 rounded-md bg-w3-slate border border-zinc-600 text-xs font-semibold text-white hover:border-w3-green focus-visible:ring-2 focus-visible:ring-w3-green">
          <span class="lang-en">{UI_DICTIONARY.en.prevLessonBtn}</span>
          <span class="lang-ar">{UI_DICTIONARY.ar.prevLessonBtn}</span>
        </button>
        <button type="button" id="story-next-slide-btn" class="px-5 py-2 rounded-md bg-w3-green hover:bg-w3-greenHover text-xs font-semibold text-white focus-visible:ring-2 focus-visible:ring-white">
          <span class="lang-en">{UI_DICTIONARY.en.nextLessonBtn}</span>
          <span class="lang-ar">{UI_DICTIONARY.ar.nextLessonBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- MODAL 2: TABLE ROW DETAILS & MOBILE XP DRAWER MODAL                     -->
  <!-- ======================================================================= -->
  <div id="details-modal" role="dialog" aria-modal="true" aria-labelledby="details-modal-title" class="fixed inset-0 z-50 hidden bg-w3-slate/80 flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl bg-w3-card dark:bg-w3-slate text-w3-ink dark:text-w3-canvas border border-w3-line dark:border-zinc-700 p-5 sm:p-6 shadow-xl">
      <div class="flex items-center justify-between gap-2 pb-3 border-b border-w3-line dark:border-zinc-700">
        <code id="details-modal-cmd" class="px-2.5 py-1 rounded bg-w3-slate text-w3-mint font-mono text-xs font-bold">
          /skill
        </code>
        <button type="button" id="details-modal-close-btn" class="px-3 py-1 rounded bg-w3-example dark:bg-w3-slateDeep border border-w3-line dark:border-zinc-700 text-w3-ink dark:text-w3-canvas text-xs font-semibold hover:bg-w3-green hover:text-white focus-visible:ring-2 focus-visible:ring-w3-green">
          <span class="lang-en">{UI_DICTIONARY.en.modalCloseBtn}</span>
          <span class="lang-ar">{UI_DICTIONARY.ar.modalCloseBtn}</span>
        </button>
      </div>

      <h3 id="details-modal-title" class="font-display font-bold text-lg mt-4 mb-2">Skill Details</h3>
      <p id="details-modal-meta" class="text-xs font-mono text-w3-greenDark dark:text-w3-mint mb-3"></p>
      <p id="details-modal-desc" class="text-sm text-w3-muted dark:text-zinc-200 leading-relaxed mb-5"></p>

      <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-w3-line dark:border-zinc-700">
        <button type="button" id="details-modal-try-btn" class="px-4 py-2 rounded-md bg-w3-green hover:bg-w3-greenHover text-white font-semibold text-xs focus-visible:ring-2 focus-visible:ring-w3-green">
          <span class="lang-en">{UI_DICTIONARY.en.modalTryInSimBtn}</span>
          <span class="lang-ar">{UI_DICTIONARY.ar.modalTryInSimBtn}</span>
        </button>
        <button type="button" id="details-modal-copy-btn" class="px-4 py-2 rounded-md bg-w3-example dark:bg-w3-slateDeep border border-w3-line dark:border-zinc-700 text-w3-ink dark:text-w3-canvas font-semibold text-xs hover:border-w3-green focus-visible:ring-2 focus-visible:ring-w3-green">
          <span class="lang-en">{UI_DICTIONARY.en.modalCopyCmdBtn}</span>
          <span class="lang-ar">{UI_DICTIONARY.ar.modalCopyCmdBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- CUSTOM TOAST NOTIFICATION BANNER (Zero window.alert()!) -->
  <div id="w3-toast" role="status" aria-live="polite" class="fixed bottom-16 lg:bottom-6 end-4 z-50 hidden px-4 py-3 rounded-xl bg-w3-slate text-white border-s-4 border-w3-green shadow-lg text-xs sm:text-sm font-semibold">
    Notification
  </div>

  <!-- CLIENT-SIDE INTERACTIVE STATE ENGINE -->
  <script is:inline define:vars={{ clientPayload }}>
    (function () {
      const DATA = JSON.parse(clientPayload);
      const STORAGE_KEY = 'agent_os_w3_learning_v115';

      let state = {
        lang: 'en',
        theme: 'light',
        mode: 'social',
        activeLessonId: 'ch-intro',
        activeStoryIdx: 0,
        activeSlideIdx: 0,
        xp: 0,
        completedLessons: [],
        completedQuizzes: [],
        likedLessons: {},
        savedToolkit: []
      };

      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          state = Object.assign({}, state, parsed);
        }
      } catch (_e) {
        // Fallback if storage blocked
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (_e) {
          // Ignore storage quota errors
        }
      }

      function showToast(msgEn, msgAr) {
        const toast = document.getElementById('w3-toast');
        if (!toast) return;
        toast.textContent = state.lang === 'ar' ? msgAr : msgEn;
        toast.classList.remove('hidden');
        clearTimeout(window.__w3ToastTimer);
        window.__w3ToastTimer = setTimeout(function () {
          toast.classList.add('hidden');
        }, 2600);
      }

      function applyLangAndTheme() {
        const htmlEl = document.documentElement;
        htmlEl.setAttribute('lang', state.lang);
        htmlEl.setAttribute('dir', state.lang === 'ar' ? 'rtl' : 'ltr');

        if (state.theme === 'dark') {
          htmlEl.classList.add('dark');
        } else {
          htmlEl.classList.remove('dark');
        }

        const topSearch = document.getElementById('global-top-search');
        if (topSearch) {
          topSearch.setAttribute('placeholder', DATA.ui[state.lang].searchPlaceholder);
        }
        const refSearch = document.getElementById('skill-dict-search');
        if (refSearch) {
          refSearch.setAttribute('placeholder', DATA.ui[state.lang].refSearchPlaceholder);
        }

        renderReaderLesson(state.activeLessonId);
        renderSimulatorOutput();
        renderXpAndToolkit();
      }

      function switchMode(newMode) {
        state.mode = newMode;
        const views = {
          social: document.getElementById('view-social'),
          reader: document.getElementById('view-reader'),
          simulator: document.getElementById('view-simulator'),
          reference: document.getElementById('view-reference')
        };
        Object.keys(views).forEach(function (k) {
          if (views[k]) {
            if (k === newMode) {
              views[k].classList.remove('hidden');
            } else {
              views[k].classList.add('hidden');
            }
          }
        });

        document.querySelectorAll('.mode-tab-btn').forEach(function (btn) {
          if (btn.getAttribute('data-switch-mode') === newMode) {
            btn.className = 'mode-tab-btn px-3 py-1.5 rounded-md text-xs font-semibold bg-w3-green text-white focus-visible:ring-2 focus-visible:ring-w3-green micro-transition';
          } else {
            btn.className = 'mode-tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-w3-ink dark:text-zinc-100 hover:bg-w3-card dark:hover:bg-w3-slate focus-visible:ring-2 focus-visible:ring-w3-green micro-transition';
          }
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function getRankTitle(xp) {
        const ui = DATA.ui[state.lang];
        if (xp >= 250) return ui.rank3;
        if (xp >= 125) return ui.rank2;
        if (xp >= 50) return ui.rank1;
        return ui.rank0;
      }

      function renderXpAndToolkit() {
        const headerXp = document.getElementById('header-xp-count');
        const railXp = document.getElementById('rail-xp-pill');
        const railRank = document.getElementById('rail-rank-label');
        const railBar = document.getElementById('rail-xp-bar');
        const railDone = document.getElementById('rail-completed-count');

        if (headerXp) headerXp.textContent = state.xp + ' XP';
        if (railXp) railXp.textContent = state.xp + ' XP';
        if (railRank) railRank.textContent = getRankTitle(state.xp);
        if (railBar) {
          const pct = Math.min(100, Math.round((state.xp / 300) * 100));
          railBar.style.width = pct + '%';
        }
        if (railDone) {
          railDone.textContent = state.completedLessons.length + ' / ' + DATA.lessons.length;
        }

        // Update sidebar completion ticks
        document.querySelectorAll('[data-lesson-tick]').forEach(function (el) {
          const id = el.getAttribute('data-lesson-tick');
          if (state.completedLessons.indexOf(id) !== -1) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        // Update Saved Toolkit list
        const savedContainer = document.getElementById('rail-saved-list');
        if (savedContainer) {
          if (!state.savedToolkit || state.savedToolkit.length === 0) {
            savedContainer.innerHTML = '<p>' + DATA.ui[state.lang].rightRailToolkitEmpty + '</p>';
          } else {
            savedContainer.innerHTML = state.savedToolkit
              .map(function (item) {
                const label = state.lang === 'ar' ? item.titleAr : item.titleEn;
                return (
                  '<div class="flex items-center justify-between gap-2 p-2 rounded bg-w3-canvas dark:bg-w3-slateDeep border border-w3-line dark:border-zinc-700">' +
                  '<div class="min-w-0 flex-1">' +
                  '<code class="font-mono text-xs font-bold text-w3-greenDark dark:text-w3-mint block">' +
                  item.cmd +
                  '</code>' +
                  '<span class="text-xs text-w3-ink dark:text-zinc-200 truncate block">' +
                  label +
                  '</span>' +
                  '</div>' +
                  '<button type="button" data-try-command="' +
                  item.cmd +
                  '" class="px-2 py-1 rounded bg-w3-green text-white text-xs font-semibold shrink-0">»</button>' +
                  '</div>'
                );
              })
              .join('');
          }
        }
      }

      function renderReaderLesson(lessonId) {
        const idx = DATA.lessons.findIndex(function (l) {
          return l.id === lessonId;
        });
        const lesson = idx !== -1 ? DATA.lessons[idx] : DATA.lessons[0];
        state.activeLessonId = lesson.id;

        const isAr = state.lang === 'ar';
        const badgeEl = document.getElementById('reader-lesson-badge');
        const titleEl = document.getElementById('reader-title');
        const summaryEl = document.getElementById('reader-summary');
        const bulletsEl = document.getElementById('reader-bullets');
        const beforeEl = document.getElementById('reader-before');
        const afterEl = document.getElementById('reader-after');
        const exTitleEl = document.getElementById('reader-example-title');
        const cmdPillEl = document.getElementById('reader-command-pill');
        const codeBoxEl = document.getElementById('reader-code-box');
        const quizQEl = document.getElementById('reader-quiz-question');
        const quizOptsEl = document.getElementById('reader-quiz-options');
        const quizFbEl = document.getElementById('reader-quiz-feedback');

        if (badgeEl) badgeEl.textContent = isAr ? lesson.badgeAr : lesson.badgeEn;
        if (titleEl) titleEl.textContent = isAr ? lesson.titleAr : lesson.titleEn;
        if (summaryEl) summaryEl.textContent = isAr ? lesson.summaryAr : lesson.summaryEn;
        if (bulletsEl) {
          const list = isAr ? lesson.bulletsAr : lesson.bulletsEn;
          bulletsEl.innerHTML = list
            .map(function (item) {
              return (
                '<li class="flex items-start gap-2.5">' +
                '<span class="inline-block w-2 h-2 rounded-full bg-w3-green mt-2 shrink-0"></span>' +
                '<span>' +
                item +
                '</span>' +
                '</li>'
              );
            })
            .join('');
        }
        if (beforeEl) beforeEl.textContent = isAr ? lesson.beforeAr : lesson.beforeEn;
        if (afterEl) afterEl.textContent = isAr ? lesson.afterAr : lesson.afterEn;
        if (exTitleEl) exTitleEl.textContent = isAr ? lesson.exampleTitleAr : lesson.exampleTitleEn;
        if (cmdPillEl) cmdPillEl.textContent = lesson.command;
        if (codeBoxEl) codeBoxEl.textContent = isAr ? lesson.promptAr : lesson.promptEn;

        // Sidebar active state
        document.querySelectorAll('.sidebar-lesson-btn').forEach(function (btn) {
          if (btn.getAttribute('data-open-lesson') === lesson.id) {
            btn.className = 'sidebar-lesson-btn w-full flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-xs text-start border bg-w3-green text-white font-semibold border-w3-green shadow-sm focus-visible:ring-2 focus-visible:ring-w3-green micro-transition';
          } else {
            btn.className = 'sidebar-lesson-btn w-full flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-xs text-start border bg-w3-card dark:bg-w3-slateDeep text-w3-ink dark:text-zinc-100 border-w3-line dark:border-zinc-700 hover:border-w3-green focus-visible:ring-2 focus-visible:ring-w3-green micro-transition';
          }
        });

        // Quiz rendering
        if (quizQEl && quizOptsEl && lesson.quiz) {
          quizQEl.textContent = isAr ? lesson.quiz.questionAr : lesson.quiz.questionEn;
          const opts = isAr ? lesson.quiz.optionsAr : lesson.quiz.optionsEn;
          if (quizFbEl) quizFbEl.classList.add('hidden');
          quizOptsEl.innerHTML = opts
            .map(function (optText, optIndex) {
              return (
                '<button type="button" data-quiz-idx="' +
                optIndex +
                '" class="w-full text-start p-3 rounded-lg bg-w3-slateDeep hover:bg-w3-green text-xs sm:text-sm text-white border border-zinc-600 font-medium focus-visible:ring-2 focus-visible:ring-w3-green micro-transition">' +
                optText +
                '</button>'
              );
            })
            .join('');
        }
      }

      function renderSimulatorOutput() {
        const cmdSelect = document.getElementById('sim-command-select');
        const stackSelect = document.getElementById('sim-stack-select');
        const stage1List = document.getElementById('sim-stage1-list');
        const stage2Pills = document.getElementById('sim-stage2-pills');
        const stage3Files = document.getElementById('sim-stage3-files');
        const stackBadge = document.getElementById('sim-active-stack-badge');

        const selectedCmd = cmdSelect ? cmdSelect.value : '/start-project';
        const selectedStackId = stackSelect ? stackSelect.value : 'astro';
        const isAr = state.lang === 'ar';

        const lessonMatch =
          DATA.lessons.find(function (l) {
            return l.command === selectedCmd;
          }) || DATA.lessons[0];

        const stackMatch =
          DATA.techStacks.find(function (s) {
            return s.id === selectedStackId;
          }) || DATA.techStacks[0];

        if (stackBadge) stackBadge.textContent = stackMatch.badge;

        if (stage1List) {
          const qs = isAr ? lessonMatch.simQuestionsAr : lessonMatch.simQuestionsEn;
          stage1List.innerHTML = qs
            .map(function (q) {
              return '<li>• ' + q + '</li>';
            })
            .join('');
        }

        if (stage2Pills) {
          const combinedSkills = Array.from(new Set(lessonMatch.chainedSkills.concat(stackMatch.stackSkills)));
          stage2Pills.innerHTML = combinedSkills
            .map(function (sk) {
              return '<span class="px-2.5 py-1 rounded bg-w3-slate border border-w3-green text-w3-mint font-mono text-xs">' + sk + '</span>';
            })
            .join('');
        }

        if (stage3Files) {
          const files = isAr ? stackMatch.filesAr : stackMatch.filesEn;
          stage3Files.innerHTML = files
            .map(function (f) {
              return '<li>+ ' + f + '</li>';
            })
            .join('');
        }
      }

      function openStoryModal(storyIdx) {
        state.activeStoryIdx = storyIdx;
        state.activeSlideIdx = 0;
        renderStorySlide();
        const modal = document.getElementById('story-player-modal');
        if (modal) modal.classList.remove('hidden');
      }

      function renderStorySlide() {
        const reel = DATA.storyReels[state.activeStoryIdx] || DATA.storyReels[0];
        const slide = reel.slides[state.activeSlideIdx] || reel.slides[0];
        const isAr = state.lang === 'ar';

        const barsEl = document.getElementById('story-progress-bars');
        const stepBadge = document.getElementById('story-step-badge');
        const titleEl = document.getElementById('story-modal-title');
        const bodyEl = document.getElementById('story-modal-body');
        const codeEl = document.getElementById('story-modal-code');

        if (barsEl) {
          barsEl.innerHTML = reel.slides
            .map(function (_, idx) {
              const activeClass = idx <= state.activeSlideIdx ? 'bg-w3-green' : 'bg-zinc-700';
              return '<div class="flex-1 h-1.5 rounded-full ' + activeClass + '"></div>';
            })
            .join('');
        }
        if (stepBadge) stepBadge.textContent = isAr ? slide.stepLabelAr : slide.stepLabelEn;
        if (titleEl) titleEl.textContent = isAr ? slide.headingAr : slide.headingEn;
        if (bodyEl) bodyEl.textContent = isAr ? slide.bodyAr : slide.bodyEn;
        if (codeEl) {
          if (slide.code) {
            codeEl.textContent = slide.code;
            codeEl.classList.remove('hidden');
          } else {
            codeEl.classList.add('hidden');
          }
        }
      }

      function openMobileDrawer(open) {
        const sidebar = document.getElementById('w3-sidebar');
        const backdrop = document.getElementById('mobile-drawer-backdrop');
        if (!sidebar || !backdrop) return;
        if (open) {
          sidebar.classList.remove('-translate-x-full', 'rtl:translate-x-full');
          backdrop.classList.remove('hidden');
        } else {
          sidebar.classList.add('-translate-x-full', 'rtl:translate-x-full');
          backdrop.classList.add('hidden');
        }
      }

      // Global Event Delegation
      document.addEventListener('click', function (e) {
        const target = e.target.closest('button');
        if (!target) return;

        // Mode switch
        const modeAttr = target.getAttribute('data-switch-mode');
        if (modeAttr) {
          switchMode(modeAttr);
          openMobileDrawer(false);
          return;
        }

        // Ribbon lesson shortcut
        const ribbonLesson = target.getAttribute('data-ribbon-lesson');
        if (ribbonLesson) {
          renderReaderLesson(ribbonLesson);
          switchMode('reader');
          return;
        }

        // Open lesson in Reader
        const lessonId = target.getAttribute('data-open-lesson');
        if (lessonId) {
          renderReaderLesson(lessonId);
          switchMode('reader');
          openMobileDrawer(false);
          return;
        }

        // Open Story Reel
        const storyIdx = target.getAttribute('data-open-story');
        if (storyIdx !== null) {
          openStoryModal(parseInt(storyIdx, 10));
          return;
        }

        // Try Command in Simulator
        const tryCmd = target.getAttribute('data-try-command');
        if (tryCmd) {
          const cmdSelect = document.getElementById('sim-command-select');
          const promptArea = document.getElementById('sim-prompt-textarea');
          if (cmdSelect) cmdSelect.value = tryCmd;
          const pEn = target.getAttribute('data-try-prompt-en');
          const pAr = target.getAttribute('data-try-prompt-ar');
          if (promptArea && (pEn || pAr)) {
            promptArea.value = state.lang === 'ar' ? pAr || pEn : pEn;
          }
          renderSimulatorOutput();
          const detailsModal = document.getElementById('details-modal');
          if (detailsModal) detailsModal.classList.add('hidden');
          switchMode('simulator');
          return;
        }

        // Copy Command / Prompt
        const copyEn = target.getAttribute('data-copy-text-en');
        if (copyEn) {
          const copyAr = target.getAttribute('data-copy-text-ar') || copyEn;
          const textToCopy = state.lang === 'ar' ? copyAr : copyEn;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(textToCopy);
          }
          showToast(DATA.ui.en.toastCopied, DATA.ui.ar.toastCopied);
          return;
        }

        // Helpful reaction
        const likeId = target.getAttribute('data-like-lesson');
        if (likeId) {
          state.likedLessons[likeId] = (state.likedLessons[likeId] || 12) + 1;
          const countEl = document.querySelector('[data-like-count="' + likeId + '"]');
          if (countEl) countEl.textContent = String(state.likedLessons[likeId]);
          saveState();
          return;
        }

        // Bookmark to Toolkit
        const bmCmd = target.getAttribute('data-bookmark-cmd');
        if (bmCmd) {
          const exists = state.savedToolkit.some(function (i) {
            return i.cmd === bmCmd;
          });
          if (!exists) {
            state.savedToolkit.push({
              cmd: bmCmd,
              titleEn: target.getAttribute('data-bookmark-title-en') || bmCmd,
              titleAr: target.getAttribute('data-bookmark-title-ar') || bmCmd
            });
          } else {
            state.savedToolkit = state.savedToolkit.filter(function (i) {
              return i.cmd !== bmCmd;
            });
          }
          saveState();
          renderXpAndToolkit();
          showToast(DATA.ui.en.toastSaved, DATA.ui.ar.toastSaved);
          return;
        }

        // Mark Lesson Completed
        const completeId = target.getAttribute('data-complete-lesson');
        if (completeId || target.id === 'reader-complete-btn') {
          const targetLessonId = completeId || state.activeLessonId;
          if (state.completedLessons.indexOf(targetLessonId) === -1) {
            state.completedLessons.push(targetLessonId);
            state.xp += 25;
            saveState();
            renderXpAndToolkit();
            showToast(DATA.ui.en.toastLessonDone, DATA.ui.ar.toastLessonDone);
          }
          return;
        }

        // Quiz Option Click
        const quizIdx = target.getAttribute('data-quiz-idx');
        if (quizIdx !== null) {
          const lesson = DATA.lessons.find(function (l) {
            return l.id === state.activeLessonId;
          });
          const fb = document.getElementById('reader-quiz-feedback');
          if (lesson && lesson.quiz && fb) {
            const chosen = parseInt(quizIdx, 10);
            const isCorrect = chosen === lesson.quiz.correctIndex;
            fb.classList.remove('hidden');
            if (isCorrect) {
              fb.className = 'p-3 rounded-lg text-xs sm:text-sm font-medium mb-3 bg-w3-mint text-w3-greenDark';
              fb.textContent = state.lang === 'ar' ? lesson.quiz.explanationAr : lesson.quiz.explanationEn;
              if (state.completedQuizzes.indexOf(lesson.id) === -1) {
                state.completedQuizzes.push(lesson.id);
                state.xp += 25;
                saveState();
                renderXpAndToolkit();
              }
              showToast(DATA.ui.en.toastQuizRight, DATA.ui.ar.toastQuizRight);
            } else {
              fb.className = 'p-3 rounded-lg text-xs sm:text-sm font-medium mb-3 bg-w3-pink text-red-900';
              fb.textContent = state.lang === 'ar' ? DATA.ui.ar.toastQuizWrong : DATA.ui.en.toastQuizWrong;
            }
          }
          return;
        }

        // Feed category filter
        const feedFilter = target.getAttribute('data-feed-filter');
        if (feedFilter) {
          document.querySelectorAll('.feed-filter-btn').forEach(function (b) {
            if (b.getAttribute('data-feed-filter') === feedFilter) {
              b.className = 'feed-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-w3-green text-white focus-visible:ring-2 focus-visible:ring-w3-green micro-transition';
            } else {
              b.className = 'feed-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-w3-card dark:bg-w3-slate border border-w3-line dark:border-zinc-700 text-w3-ink dark:text-w3-canvas hover:border-w3-green focus-visible:ring-2 focus-visible:ring-w3-green micro-transition';
            }
          });
          document.querySelectorAll('.feed-post-card').forEach(function (card) {
            const cat = card.getAttribute('data-feed-cat');
            if (feedFilter === 'all' || cat === feedFilter) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
          return;
        }

        // Open Skill Details Modal
        const skillName = target.getAttribute('data-open-skill-modal');
        if (skillName) {
          const sk = DATA.skills.find(function (s) {
            return s.name === skillName;
          });
          if (sk) {
            const modal = document.getElementById('details-modal');
            document.getElementById('details-modal-cmd').textContent = sk.command;
            document.getElementById('details-modal-title').textContent = sk.name;
            document.getElementById('details-modal-meta').textContent =
              (state.lang === 'ar' ? sk.categoryAr : sk.categoryEn) + ' • ' + sk.phase + ' • ' + sk.file;
            document.getElementById('details-modal-desc').textContent =
              state.lang === 'ar' ? sk.descriptionAr : sk.descriptionEn;
            const tryBtn = document.getElementById('details-modal-try-btn');
            if (tryBtn) {
              tryBtn.setAttribute('data-try-command', sk.command);
              tryBtn.setAttribute('data-try-prompt-en', sk.command + ' Apply this skill to my current task.');
              tryBtn.setAttribute('data-try-prompt-ar', sk.command + ' طبق هذه المهارة على مهمتي الحالية.');
            }
            const copyBtn = document.getElementById('details-modal-copy-btn');
            if (copyBtn) {
              copyBtn.setAttribute('data-copy-text-en', sk.command);
              copyBtn.setAttribute('data-copy-text-ar', sk.command);
            }
            if (modal) modal.classList.remove('hidden');
          }
          return;
        }

        // Open MCP Details Modal
        const mcpName = target.getAttribute('data-open-mcp-modal');
        if (mcpName) {
          const srv = DATA.mcpServers.find(function (m) {
            return m.name === mcpName;
          });
          if (srv) {
            const modal = document.getElementById('details-modal');
            document.getElementById('details-modal-cmd').textContent = 'MCP: ' + srv.name;
            document.getElementById('details-modal-title').textContent = srv.name;
            document.getElementById('details-modal-meta').textContent = 'Phase: ' + srv.phase;
            document.getElementById('details-modal-desc').textContent =
              state.lang === 'ar' ? srv.domainAr : srv.domainEn;
            if (modal) modal.classList.remove('hidden');
          }
          return;
        }
      });

      // Specific Button Listeners
      const langBtn = document.getElementById('lang-toggle-btn');
      if (langBtn) {
        langBtn.addEventListener('click', function () {
          state.lang = state.lang === 'en' ? 'ar' : 'en';
          saveState();
          applyLangAndTheme();
        });
      }

      const themeBtn = document.getElementById('theme-toggle-btn');
      if (themeBtn) {
        themeBtn.addEventListener('click', function () {
          state.theme = state.theme === 'dark' ? 'light' : 'dark';
          saveState();
          applyLangAndTheme();
        });
      }

      // Show More / Collapse All for 11 Combos 3-Card Grid
      const toggleCombosBtn = document.getElementById('toggle-combos-grid-btn');
      if (toggleCombosBtn) {
        toggleCombosBtn.addEventListener('click', function () {
          const expanded = toggleCombosBtn.getAttribute('data-expanded') === 'true';
          const nextState = !expanded;
          toggleCombosBtn.setAttribute('data-expanded', String(nextState));
          document.querySelectorAll('.combo-grid-card').forEach(function (card) {
            const idx = parseInt(card.getAttribute('data-combo-card-index') || '0', 10);
            if (idx >= 3) {
              if (nextState) card.classList.remove('hidden');
              else card.classList.add('hidden');
            }
          });
          document.getElementById('toggle-combos-label-en').textContent = nextState
            ? DATA.ui.en.collapseCombos
            : DATA.ui.en.showMoreCombos;
          document.getElementById('toggle-combos-label-ar').textContent = nextState
            ? DATA.ui.ar.collapseCombos
            : DATA.ui.ar.showMoreCombos;
        });
      }

      // Show More / Collapse All for 60-Skill Table
      const toggleSkillsBtn = document.getElementById('toggle-skills-table-btn');
      if (toggleSkillsBtn) {
        toggleSkillsBtn.addEventListener('click', function () {
          const expanded = toggleSkillsBtn.getAttribute('data-expanded') === 'true';
          const nextState = !expanded;
          toggleSkillsBtn.setAttribute('data-expanded', String(nextState));
          document.querySelectorAll('.skill-table-row').forEach(function (row, idx) {
            if (idx >= 12) {
              if (nextState) row.classList.remove('hidden');
              else row.classList.add('hidden');
            }
          });
          document.getElementById('toggle-skills-label-en').textContent = nextState
            ? DATA.ui.en.refCollapseRows
            : DATA.ui.en.refShowMoreRows;
          document.getElementById('toggle-skills-label-ar').textContent = nextState
            ? DATA.ui.ar.refCollapseRows
            : DATA.ui.ar.refShowMoreRows;
        });
      }

      // Reader Prev / Next / Try buttons
      const prevBtn = document.getElementById('reader-prev-btn');
      const nextBtn = document.getElementById('reader-next-btn');
      const readerTryBtn = document.getElementById('reader-try-btn');
      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          const idx = DATA.lessons.findIndex(function (l) {
            return l.id === state.activeLessonId;
          });
          const prevIdx = idx > 0 ? idx - 1 : DATA.lessons.length - 1;
          renderReaderLesson(DATA.lessons[prevIdx].id);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          const idx = DATA.lessons.findIndex(function (l) {
            return l.id === state.activeLessonId;
          });
          const nextIdx = idx < DATA.lessons.length - 1 ? idx + 1 : 0;
          renderReaderLesson(DATA.lessons[nextIdx].id);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
      if (readerTryBtn) {
        readerTryBtn.addEventListener('click', function () {
          const lesson =
            DATA.lessons.find(function (l) {
              return l.id === state.activeLessonId;
            }) || DATA.lessons[0];
          const cmdSelect = document.getElementById('sim-command-select');
          const promptArea = document.getElementById('sim-prompt-textarea');
          if (cmdSelect) cmdSelect.value = lesson.command;
          if (promptArea) promptArea.value = state.lang === 'ar' ? lesson.promptAr : lesson.promptEn;
          renderSimulatorOutput();
          switchMode('simulator');
        });
      }

      // Simulator controls
      const simCmdSelect = document.getElementById('sim-command-select');
      const simStackSelect = document.getElementById('sim-stack-select');
      const simRunBtn = document.getElementById('sim-run-btn');
      const simCopyBtn = document.getElementById('sim-copy-btn');

      if (simCmdSelect) {
        simCmdSelect.addEventListener('change', function () {
          const combo = DATA.combos.find(function (c) {
            return c.command === simCmdSelect.value;
          });
          const promptArea = document.getElementById('sim-prompt-textarea');
          if (combo && promptArea) {
            promptArea.value = state.lang === 'ar' ? combo.samplePromptAr : combo.samplePromptEn;
          }
          renderSimulatorOutput();
        });
      }
      if (simStackSelect) {
        simStackSelect.addEventListener('change', renderSimulatorOutput);
      }
      if (simRunBtn) {
        simRunBtn.addEventListener('click', function () {
          renderSimulatorOutput();
          showToast('Executed live simulation pipeline!', 'تم تشغيل محاكاة خط العمل بنجاح!');
        });
      }
      if (simCopyBtn) {
        simCopyBtn.addEventListener('click', function () {
          const promptArea = document.getElementById('sim-prompt-textarea');
          if (promptArea && navigator.clipboard) {
            navigator.clipboard.writeText(promptArea.value);
          }
          showToast(DATA.ui.en.toastCopied, DATA.ui.ar.toastCopied);
        });
      }

      // Story Modal controls
      const storyClose = document.getElementById('story-close-btn');
      const storyPrev = document.getElementById('story-prev-slide-btn');
      const storyNext = document.getElementById('story-next-slide-btn');
      if (storyClose) {
        storyClose.addEventListener('click', function () {
          document.getElementById('story-player-modal').classList.add('hidden');
        });
      }
      if (storyPrev) {
        storyPrev.addEventListener('click', function () {
          if (state.activeSlideIdx > 0) {
            state.activeSlideIdx -= 1;
            renderStorySlide();
          }
        });
      }
      if (storyNext) {
        storyNext.addEventListener('click', function () {
          const reel = DATA.storyReels[state.activeStoryIdx] || DATA.storyReels[0];
          if (state.activeSlideIdx < reel.slides.length - 1) {
            state.activeSlideIdx += 1;
            renderStorySlide();
          } else {
            document.getElementById('story-player-modal').classList.add('hidden');
          }
        });
      }

      // Details Modal close
      const detailsClose = document.getElementById('details-modal-close-btn');
      if (detailsClose) {
        detailsClose.addEventListener('click', function () {
          document.getElementById('details-modal').classList.add('hidden');
        });
      }

      // Mobile Drawer controls
      const drawerOpenBtn = document.getElementById('mobile-drawer-open-btn');
      const drawerBottomBtn = document.getElementById('mobile-bottom-chapters-btn');
      const drawerCloseBtn = document.getElementById('mobile-drawer-close-btn');
      const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
      if (drawerOpenBtn) drawerOpenBtn.addEventListener('click', function () { openMobileDrawer(true); });
      if (drawerBottomBtn) drawerBottomBtn.addEventListener('click', function () { openMobileDrawer(true); });
      if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', function () { openMobileDrawer(false); });
      if (drawerBackdrop) drawerBackdrop.addEventListener('click', function () { openMobileDrawer(false); });

      // Mobile XP button & Header XP button
      const mobileXpBtn = document.getElementById('mobile-bottom-xp-btn');
      const topXpBtn = document.getElementById('top-xp-badge-btn');
      function showXpSummaryModal() {
        const modal = document.getElementById('details-modal');
        document.getElementById('details-modal-cmd').textContent = state.xp + ' XP';
        document.getElementById('details-modal-title').textContent = getRankTitle(state.xp);
        document.getElementById('details-modal-meta').textContent =
          DATA.ui[state.lang].rightRailCompletedLabel + ': ' + state.completedLessons.length + ' / ' + DATA.lessons.length;
        const savedNames = state.savedToolkit.map(function (i) { return i.cmd; }).join(', ') || 'None yet';
        document.getElementById('details-modal-desc').textContent =
          DATA.ui[state.lang].rightRailToolkitTitle + ': ' + savedNames;
        if (modal) modal.classList.remove('hidden');
      }
      if (mobileXpBtn) mobileXpBtn.addEventListener('click', showXpSummaryModal);
      if (topXpBtn) topXpBtn.addEventListener('click', showXpSummaryModal);

      // Search & Category Filtering in 60-Skill Reference Dictionary
      const dictSearch = document.getElementById('skill-dict-search');
      const dictCatSelect = document.getElementById('skill-dict-cat-select');
      const globalSearch = document.getElementById('global-top-search');

      function filterSkillsTable() {
        const q = (dictSearch ? dictSearch.value : '').trim().toLowerCase();
        const cat = dictCatSelect ? dictCatSelect.value : 'ALL';
        document.querySelectorAll('.skill-table-row').forEach(function (row, idx) {
          const rowCat = row.getAttribute('data-skill-cat') || '';
          const rowCorpus = row.getAttribute('data-skill-search') || '';
          const matchesCat = cat === 'ALL' || rowCat === cat;
          const matchesQuery = !q || rowCorpus.indexOf(q) !== -1;
          if (matchesCat && matchesQuery) {
            if (!q && cat === 'ALL' && idx >= 12 && toggleSkillsBtn && toggleSkillsBtn.getAttribute('data-expanded') !== 'true') {
              row.classList.add('hidden');
            } else {
              row.classList.remove('hidden');
            }
          } else {
            row.classList.add('hidden');
          }
        });
      }

      if (dictSearch) dictSearch.addEventListener('input', filterSkillsTable);
      if (dictCatSelect) dictCatSelect.addEventListener('change', filterSkillsTable);
      if (globalSearch) {
        globalSearch.addEventListener('input', function () {
          if (globalSearch.value.trim().length > 1) {
            if (dictSearch) dictSearch.value = globalSearch.value;
            switchMode('reference');
            filterSkillsTable();
          }
        });
      }

      // Initial boot
      applyLangAndTheme();
    })();
  </script>
</W3Layout>
